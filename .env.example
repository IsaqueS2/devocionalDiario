POSTGRES_DB=devocional
POSTGRES_USER=devocional
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
DOMAIN=:80
# O Neon CLI grava DATABASE_URL em .env.local (ou neste .env, se ele existir).
DATABASE_URL=
# Alternativa para uma connection string PostgreSQL no formato Npgsql.
NEON_CONNECTION_STRING=
